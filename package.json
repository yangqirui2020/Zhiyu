{
  "name": "zhiyu-yixi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.4"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node --conditions=react-server scripts/validate-snapshots/check.ts",
