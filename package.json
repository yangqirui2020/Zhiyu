    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "ml-hclust": "4.0.0",
